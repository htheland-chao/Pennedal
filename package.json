{
  "name": "pennedal",
  "private": true,
  "version": "0.1.0",
  "description": "Pennedal - et danskfagligt fantasy-læringsspil til 5. klasse",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "stavetjek": "node scripts/stavetjek.mjs",
    "korrektur": "node scripts/korrektur.mjs",
    "lyd": "node scripts/lav-lyd.mjs",
    "lyd:status": "node scripts/lav-lyd.mjs --kun-status",
    "tjek": "npm run typecheck && npm run test && npm run stavetjek && npm run build"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@fontsource/pixelify-sans": "5.2.7",
    "phaser": "4.2.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dictionary-da": "6.0.0",
    "jsdom": "30.1.3",
    "nspell": "2.1.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
