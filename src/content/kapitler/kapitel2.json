  "trin": [
    {
      "id": "k2-ankomst",
      "type": "dialog",
      "del": 1,
      "sted": "byporten",
      "objekt": null,
      "replikker": [
        {
          "taler": "fortaeller",
          "tekst": "Morgensolen står op over en eng fuld af blomster. Græsset dufter af blæk og honning."
        },
        {
          "taler": "fortaeller",
          "tekst": "For enden af stien ligger en by bag en høj mur. Hustagene er røde, grønne og blå, og fra skorstenene stiger der små skyer af røg."
        },
        {
          "taler": "aeseloere",
          "tekst": "Sætningsbyen. Her bor de mest snakkesalige væsner i hele Pennedal."
        },
        {
          "taler": "aeseloere",
          "tekst": "Men hør. Plejer de ikke at holde en lille pause en gang imellem?"
        }
      ]
    },
    {
      "id": "k2-portvagt",
      "type": "dialog",
      "del": 1,
      "sted": "byporten",
      "objekt": "portvagt",
      "opgavetekst": "Tal med Portvagten ved byporten.",
      "replikker": [
        {
          "taler": "portvagt",
          "tekst": "Goddag og velkommen og porten er lukket og jeg kan ikke åbne den og jeg kan ikke holde op med at snakke og det er ret trættende og nu har jeg glemt, hvad jeg ville sige."
        },
        {
          "taler": "aeseloere",
          "tekst": "Han er en og-orm på to ben. Nogen har stjålet hans punktummer."
        },
        {
          "taler": "portvagt",
          "tekst": "Kan du klippe mine sætninger over og så åbner porten sig og så kan jeg måske få vejret og ..."
        }
      ]
    },
    {
      "id": "k2-ogorm",
      "type": "opgave",
      "del": 1,
      "sted": "byporten",
      "objekt": "port",
      "opgavetekst": "Klip Portvagtens og-orme over, så porten åbner sig.",
      "mekanik": "ogorm",
      "faerdighed": "tegn.punktum_stort",
      "antal": 3
    },
    {
      "id": "k2-port-aaben",
      "type": "dialog",
      "del": 1,
      "sted": "byporten",
      "objekt": null,
      "slutDel": 1,
      "replikker": [
        {
          "taler": "portvagt",
          "tekst": "Åh. En pause. Tak. Jeg havde glemt, hvor rart det er at stoppe en sætning."
        },
        {
          "taler": "portvagt",
          "tekst": "I nat forsvandt alle byens tegn. Punktummer, spørgsmålstegn og udråbstegn. Nu snakker alle i munden på hinanden."
        },
        {
          "taler": "fortaeller",
          "tekst": "Med et tungt suk glider porten op. Bag den summer byen som en bikube."
        }
      ]
    },
    {
      "id": "k2-ind",
      "type": "skift",
      "del": 2,
      "sted": "byporten",
      "objekt": "port",
      "opgavetekst": "Gå ind gennem porten.",
      "tilSted": "torvet"
    },
    {
      "id": "k2-torvet",
      "type": "dialog",
      "del": 2,
      "sted": "torvet",
      "objekt": null,
      "replikker": [
        {
          "taler": "fortaeller",
          "tekst": "Torvet er fyldt med mennesker. Alle taler på én gang, og ingen lytter."
        },
        {
          "taler": "fortaeller",
          "tekst": "Midt på torvet står et springvand. Det er helt tørt, og bunden er plettet af noget sort."
        },
        {
          "taler": "aeseloere",
          "tekst": "Blæk. Jeg kender den lugt. Den hører til en vis klodset gnom."
        }
      ]
    },
    {
      "id": "k2-borgmester",
      "type": "dialog",
      "del": 2,
      "sted": "torvet",
      "objekt": "borgmester",
      "opgavetekst": "Find Borgmesteren på torvet.",
      "replikker": [
        {
          "taler": "borgmester",
          "tekst": "Endelig én, der står stille. Jeg er byens borgmester, og jeg har aldrig set så meget rod."
        },
        {
          "taler": "borgmester",
          "tekst": "Uden tegn ved ingen, om man spørger om noget, råber noget eller bare fortæller noget."
        },
        {
          "taler": "borgmester",
          "tekst": "Vores Råber står ved springvandet. Han skal læse byens nyheder op, men han kan ikke finde ud af, hvordan han skal sige dem."
        }
      ]
    },
    {
      "id": "k2-raaber",
      "type": "opgave",
      "del": 2,
      "sted": "torvet",
      "objekt": "raaber",
      "opgavetekst": "Hjælp Råberen med at sætte de rigtige tegn.",
      "mekanik": "raaber",
      "faerdighed": "tegn.saetningstegn",
      "antal": 6
    },
    {
      "id": "k2-raaber-tak",
      "type": "dialog",
      "del": 2,
      "sted": "torvet",
      "objekt": null,
      "replikker": [
        {
          "taler": "raaber",
          "tekst": "Hør, hør! Nu kan jeg råbe igen! Tusind tak!"
        },
        {
          "taler": "fortaeller",
          "tekst": "For første gang i lang tid bliver der stille på torvet. Folk lytter."
        },
        {
          "taler": "raaber",
          "tekst": "Byrådet har hængt et opslag op. Det handler om tyveriet. Læs det!"
        }
      ]
    },
    {
      "id": "k2-opslag",
      "type": "bevisjagt",
      "del": 2,
      "sted": "torvet",
      "objekt": "opslag",
      "opgavetekst": "Læs byrådets opslag.",
      "faerdighed": "laes.praecision",
      "forforstaaelse": [
        "byraad",
        "opslag",
        "smoege"
      ],
      "titel": "Byrådets opslag",
      "saetninger": [
        "Til alle i Sætningsbyen.",
        "I nat blev alle byens tegn stjålet fra {{trykkeriet}}.",
        "Nattevagten så en lille, sort skikkelse løbe over torvet med en tung sæk.",
        "Skikkelsen efterlod sorte pletter på brostenene.",
        "Pletterne fører ned i {{smøgen|smoege}} mod øst.",
        "Har du set noget, så kontakt {{byrådet|byraad}}."
      ],
      "spoergsmaal": [
        {
          "id": "k2-opslag-1",
          "tekst": "Hvad bar skikkelsen på?",
          "svar": 2,
          "forkert": {
            "3": "Den sætning handler om pletterne. Find sætningen, der fortæller, hvad skikkelsen bar på.",
            "1": "Den sætning fortæller, hvor tegnene blev stjålet fra. Find sætningen om skikkelsen."
          },
          "standard": "Find sætningen, hvor nattevagten fortæller, hvad han så."
        },
        {
          "id": "k2-opslag-2",
          "tekst": "Hvor fører sporet hen?",
          "svar": 4,
          "forkert": {
            "3": "Den sætning fortæller, at der er pletter, men ikke hvor de fører hen. Læs den næste sætning.",
            "2": "Den sætning handler om skikkelsen. Find sætningen, der siger, hvor pletterne fører hen."
          },
          "standard": "Find sætningen med ordet fører."
        }
      ]
    },
    {
      "id": "k2-spor",
      "type": "dialog",
      "del": 2,
      "sted": "torvet",
      "objekt": null,
      "slutDel": 2,
      "replikker": [
        {
          "taler": "aeseloere",
          "tekst": "En lille, sort skikkelse med en sæk. Jeg tør vædde mine bedste sider på, at det er Klatten."
        },
        {
          "taler": "fortaeller",
          "tekst": "Ved kanten af torvet ser du det: små, sorte pletter, der forsvinder ind i en smal smøge."
        },
        {
          "taler": "fortaeller",
          "tekst": "Et sted derinde griner nogen. Det lyder som en, der prøver at være uhyggelig og ikke helt kan."
        }
      ]
    },
    {
      "id": "k2-til-smoeger",
      "type": "skift",
      "del": 3,
      "sted": "torvet",
      "objekt": "smoege",
      "opgavetekst": "Følg blækpletterne ind i smøgen mod øst.",
      "tilSted": "smoegerne"
    },
    {
      "id": "k2-smoeger",
      "type": "dialog",
      "del": 3,
      "sted": "smoegerne",
      "objekt": null,
      "replikker": [
        {
          "taler": "fortaeller",
          "tekst": "Smøgerne er så smalle, at husene næsten rører hinanden. Larmen fra torvet bliver svagere og svagere."
        },
        {
          "taler": "aeseloere",
          "tekst": "Følg pletterne. Og gå ikke for hurtigt. Jeg bliver blød, hvis jeg falder i en vandpyt."
        }
      ]
    },
    {
      "id": "k2-til-trykkeri",
      "type": "skift",
      "del": 3,
      "sted": "smoegerne",
      "objekt": "trykkeridoer",
      "opgavetekst": "Følg sporet hen til døren for enden af smøgen.",
      "tilSted": "trykkeriet"
    },
    {
      "id": "k2-trykkeri",
      "type": "dialog",
      "del": 3,
      "sted": "trykkeriet",
      "objekt": null,
      "replikker": [
        {
          "taler": "fortaeller",
          "tekst": "Døren knirker. Indenfor er det mørkt og koldt, og luften smager af metal og gammelt blæk."
        },
        {
          "taler": "fortaeller",
          "tekst": "Langs væggen står et stort {{typeskab|typeskab}}. Midt på lågen er der tre tomme huller og en lås med tal."
        },
        {
          "taler": "aeseloere",
          "tekst": "Her har de trykt byens bøger i hundrede år. Og nogen har haft travlt i nat."
        },
        {
          "taler": "fortaeller",
          "tekst": "Over dig knirker loftet. Nogen går på taget."
        }
      ]
    },
