        "skaar": "k4b",
        "fra": "toppen",
        "opgavetekst": "Kom helt over den iskolde kam. Den er svær med vilje.",
        "ind": [
          { "taler": "aeseloere", "tekst": "Den kam er glat som glas, og vinden blæser hårdt. Der er kun én lanterne, og jeg bærer dig ikke over." },
          { "taler": "aeseloere", "tekst": "Den er svær med vilje. Du behøver ikke at gå den for at komme videre. Men for enden glimter noget." }
        ],
        "spoergsmaal": "Vil du gå over den iskolde kam?",
        "ja": "Gå ud på kammen",
        "nej": "Ikke nu",
        "faerdig": [
          { "taler": "fortaeller", "tekst": "For enden af kammen sidder en lille, lysende papirstump fast i isen. Det er et hukommelsesskår." },
          { "taler": "aeseloere", "tekst": "Du gik hele vejen. Jeg kiggede væk de svære steder. Det hjalp ikke." }
        ],
        "igen": [
          { "taler": "aeseloere", "tekst": "Igen? Du er godt nok sej. Skåret har du allerede." }
        ]
      },
